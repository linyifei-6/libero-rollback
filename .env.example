# LIBERO-Rollback local configuration template.
# Copy to .env and edit. Scripts do NOT auto-load .env; `source` it or export manually.
#
#   cp .env.example .env && set -a && . ./.env && set +a

# Upstream LIBERO checkout (the repository root that contains the `libero` package).
LIBERO_HOME=/path/to/LIBERO

# Repo-local LIBERO config dir (config.yaml is generated by scripts/bootstrap_libero.py).
# Never point this at ~/.libero.
LIBERO_CONFIG_PATH=/path/to/libero-rollback/.cache/libero

# Rendering backend for MuJoCo: egl (GPU) or osmesa (CPU / CI).
MUJOCO_GL=egl

# Optional: override the interpreter that can import robosuite/mujoco/bddl.
# LIBERO_PYTHON=/path/to/.venv-sim/bin/python

# Optional: model checkpoint overrides (see configs/models.yaml for defaults).
# PI05_CHECKPOINT=/path/to/pi05_libero
# OPENVLA_OFT_CHECKPOINT=/path/to/openvla-7b-oft-finetuned-libero-spatial-object-goal-10
# SMOLVLA_CHECKPOINT=/path/to/smolvla_libero
